# --- Python ---
.venv/
.cache/
__pycache__/
*.py[cod]
*.egg-info/
logs/*
!logs/.gitkeep
tools/camera_monitor.local.json
tools/camera_monitor.docker.local.env
tools/eufy-security.local.env
tools/deploy.local.env
tools/r2-originals.local.env

# --- Swift / compiled scanner binary ---
# Architecture-specific; rebuild with `make build`.
scanner/icascan
scanner/epsonscan2
scanner/epson_runtime_dump
*.o
*.swiftmodule
*.swiftdoc

# --- Scanned images & organized photos (data, not code) ---
captures/*
!captures/.gitkeep
photos/*
!photos/.gitkeep
!photos/scanned
!photos/scanned/**
# Born-digital drawings (CAD exports) — tracked like the scans
!photos/drawings
!photos/drawings/**
!photos/_staging
photos/_staging/*
!photos/_staging/.gitkeep

# --- Photo drop zones: empty folders tracked, dropped content never ---
drop-zones/*
!drop-zones/README.txt
!drop-zones/*/
drop-zones/*/*
!drop-zones/*/.gitkeep

# --- macOS ---
.DS_Store
.wrangler/
