---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Bright Water Bog",
  description = "A trail of stained-glass sculpture in Shutesbury, Massachusetts. The work of Julian Janowitz, then and now.",
} = Astro.props;
// Absolute URLs for social previews; WhatsApp and friends reject relative ones.
// og.jpg is rendered by scripts/prerender-images.mjs during make build.
const site = Astro.site ?? new URL("https://bwb.samuelclay.com");
const ogImage = new URL("/og.jpg", site).href;
const ogUrl = new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bright Water Bog" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Stargate, a ring of stained glass on the trail at Bright Water Bog" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Set theme before first paint to avoid a flash. */}
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem("bwb-theme");
          if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <header class="topbar">
      <nav class="topbar__links" data-navspy>
        {/* slides behind the section you're on — placed by islands/nav-spy.ts */}
        <span class="topbar__pill" data-nav-pill aria-hidden="true"></span>
        <a href="#trail">Trail</a>
        <a href="#indoor">Indoor</a>
        <a href="#poetry">Poetry</a>
        <a href="#visit">Visit</a>
        {/* Light/dark toggle switch, ported from NewsBlur's welcome page. */}
        <div class="theme-toggle" data-theme-toggle title="Toggle theme">
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="14" height="14" fill="none">
            <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
            <path
              d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
          <button class="theme-toggle__track" aria-label="Toggle dark mode" type="button">
            <span class="theme-toggle__thumb"></span>
          </button>
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="14" height="14" fill="none">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" fill="currentColor"></path>
          </svg>
        </div>
      </nav>
    </header>

    <slot />

    <script>
      // Theme toggle (whole container is the click target, like NewsBlur's).
      const toggle = document.querySelector<HTMLElement>("[data-theme-toggle]");
      const effectiveTheme = () =>
        document.documentElement.dataset.theme ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      // The dissolve is opt-in per switch: the transition rules only apply
      // while .is-theme-shifting is set, so nothing animates on first paint.
      const root = document.documentElement;
      let shiftTimer: number | undefined;
      toggle?.addEventListener("click", () => {
        const next = effectiveTheme() === "dark" ? "light" : "dark";
        root.classList.add("is-theme-shifting");
        root.dataset.theme = next;
        try {
          localStorage.setItem("bwb-theme", next);
        } catch (_) {}
        window.clearTimeout(shiftTimer);
        shiftTimer = window.setTimeout(() => root.classList.remove("is-theme-shifting"), 700);
      });
    </script>
  </body>
</html>
