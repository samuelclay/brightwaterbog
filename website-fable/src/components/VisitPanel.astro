---
import visit from "../data/visit.json";
type VisitLink = { href: string; text: string };
const { lede, items } = visit as {
  lede: string;
  items: Array<{ label: string; value: string; link?: VisitLink; links?: VisitLink[] }>;
};
---

<div class="visit">
  <p class="visit__lede">{lede}</p>
  <dl class="visit__list">
    {
      items.map((it) => (
        <div class="visit__row">
          <dt>{it.label}</dt>
          <dd>
            {it.value}
            {it.link && (
              <>
                {" "}
                <a href={it.link.href} target="_blank" rel="noopener">
                  {it.link.text}
                </a>
              </>
            )}
            {it.links && (
              <span class="visit__links">
                {it.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.text}
                  </a>
                ))}
              </span>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</div>
