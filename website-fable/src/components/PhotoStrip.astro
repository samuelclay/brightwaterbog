---
import { imageUrl, srcset, STRIP_WIDTHS } from "../lib/imageUrl";
import photosData from "../data/photos.json";

// the largest photo set on the site gets the full bar width; smaller sets get
// logarithmically narrower bars — tiny sets stay pill-sized (floored by the
// pills' own min-content), but anything more than a few photos reads wide
const maxTotal = Math.max(
  1,
  ...Object.values(photosData as Record<string, unknown[]>).map((v) => v.length)
);
const barWidth = (count: number) =>
  Math.round((Math.log(count + 1) / Math.log(maxTotal + 1)) * 720);

interface PhotoEntry {
  key: string;
  era: "now" | "construction-now" | "aerial" | "then" | "construction";
  date: string | null;
  width: number | null;
  height: number | null;
  orientation: string;
}
interface Props {
  photos: PhotoEntry[];
  title: string;
  compact?: boolean;
}
const { photos, title, compact = false } = Astro.props;

const ERAS = [
  { era: "now", label: "Now", note: "Today" },
  { era: "construction-now", label: "Construction", note: "Recent work in progress" },
  { era: "aerial", label: "Aerial", note: "From above" },
  { era: "then", label: "Then", note: "As Julian built it" },
  { era: "construction", label: "Construction", note: "As Julian built it" },
] as const;

function frameData(p: PhotoEntry) {
  // Dims fingerprint busts stale browser/CDN caches when a photo is replaced.
  const v = p.width && p.height ? `${p.width}x${p.height}` : undefined;
  return {
    thumb: imageUrl(p.key, { w: 760, fit: "cover", v }),
    thumbset: srcset(p.key, STRIP_WIDTHS, "cover", 78, v),
    full: imageUrl(p.key, { w: 1800, fit: "contain", v }),
    fullHi: imageUrl(p.key, { w: 2600, fit: "contain", v }),
    w: p.width ?? 0,
    h: p.height ?? 0,
    year: p.date ? p.date.slice(0, 4) : "",
  };
}

const groups = ERAS.map((e) => ({
  ...e,
  items: photos.filter((p) => p.era === e.era).map(frameData),
})).filter((g) => g.items.length > 0);

const total = photos.length;
---

{
  total === 0 ? (
    <p class="strip__empty">No photos yet. Check back soon.</p>
  ) : (
    <div class:list={["strip", { "strip--compact": compact }]} data-strip>
      {groups.length > 0 && (
        <div
          class="strip__bar"
          role="tablist"
          aria-label={`${title} photo sections`}
          style={`max-width:min(${barWidth(total)}px, 100%)`}
        >
          {groups.map((g) => (
            <button
              class="seg"
              type="button"
              role="tab"
              data-seg={g.era}
              style={`flex-grow:${g.items.length}`}
              aria-label={`Jump to ${g.label}, ${g.items.length} photos`}
            >
              <span class="seg__fill" data-seg-fill />
              <span class="seg__label">
                {g.label} <i>{`${g.items.length} ${g.items.length === 1 ? "photo" : "photos"}`}</i>
              </span>
            </button>
          ))}
        </div>
      )}

      <div class="strip__track" data-strip-track>
        {groups.map((g) => (
          <div class="strip__group" data-group={g.era}>
            {g.items.map((f, i) => (
              <button
                class="frame"
                type="button"
                data-lightbox
                data-full={f.full}
                data-full-hi={f.fullHi}
                data-w={f.w}
                data-h={f.h}
                data-era={`${g.label}${f.year ? ` · ${f.year}` : ""}`}
                aria-label={`${title}, ${g.label} photo ${i + 1}, open full screen`}
              >
                <img
                  src={f.thumb}
                  srcset={f.thumbset}
                  sizes="440px"
                  width={f.w || undefined}
                  height={f.h || undefined}
                  loading="lazy"
                  decoding="async"
                  alt={`${title}, ${g.label.toLowerCase()} photo`}
                />
                <span class="frame__era">
                  {g.label}
                  {f.year ? ` · ${f.year}` : ""}
                </span>
              </button>
            ))}
          </div>
        ))}
      </div>
    </div>
  )
}
