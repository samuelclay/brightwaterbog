---
import { imageUrl, srcset, FULL_WIDTHS } from "../lib/imageUrl";
import photosData from "../data/photos.json";

// Big full-bleed hero: slow crossfade through the trail's headline sculptures.
const photos = photosData as Record<
  string,
  Array<{ key: string; era: string; width: number | null; height: number | null }>
>;

const FEATURED = [
  { slug: "stargate", title: "Stargate" },
  { slug: "tetris", title: "Tetris" },
  { slug: "hoopla-pyramid", title: "Hoopla Pyramid" },
  { slug: "the-dancers", title: "The Dancers" },
];

const slides = FEATURED.map(({ slug, title }) => {
  const list = photos[slug] ?? [];
  const nows = list.filter((p) => p.era === "now");
  return { title, p: nows.at(-1) ?? list[0] };
}).filter((s) => s.p);
---

<section class="hero">
  {
    slides.map(({ title, p }, i) => (
      <img
        class:list={["hero__media", { "is-active": i === 0 }]}
        src={imageUrl(p.key, { w: 2200, fit: "cover" })}
        srcset={srcset(p.key, FULL_WIDTHS, "cover")}
        sizes="100vw"
        width={p.width ?? undefined}
        height={p.height ?? undefined}
        alt={`${title} at Bright Water Bog`}
        fetchpriority={i === 0 ? "high" : undefined}
        loading={i === 0 ? undefined : "lazy"}
        decoding="async"
      />
    ))
  }
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__inner">
    <h1 class="hero__title">
      <span class="visually-hidden">Bright Water Bog</span>
      <!-- "Still Water": amber-glass type with a rippled reflection in the bog. -->
      <svg class="hero__title-glass" viewBox="0 0 720 170" aria-hidden="true" focusable="false">
        <defs>
          <!-- Milk Glass alternative: #fffdf6 / #ece4d4 / #cbbfa4 with stroke #3b473f -->
          <linearGradient id="titleGlass" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffe3ae"></stop>
            <stop offset="0.55" stop-color="#f2b45a"></stop>
            <stop offset="1" stop-color="#c97a3d"></stop>
          </linearGradient>
          <filter id="titleRipple" x="-10%" y="-10%" width="120%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.011 0.09" numOctaves="2" seed="7" result="n"></feTurbulence>
            <feDisplacementMap in="SourceGraphic" in2="n" scale="22" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
          </filter>
          <filter id="titleShadow" x="-15%" y="-15%" width="130%" height="130%">
            <feDropShadow dx="0" dy="2" stdDeviation="9" flood-color="#000" flood-opacity="0.4"></feDropShadow>
          </filter>
        </defs>
        <text class="hero__glass-text" x="4" y="84" filter="url(#titleShadow)">Bright Water Bog</text>
        <g filter="url(#titleRipple)" opacity="0.38">
          <text class="hero__glass-text" x="4" y="84" transform="translate(0 182) scale(1 -1)">Bright Water Bog</text>
        </g>
      </svg>
    </h1>
  </div>

</section>

<script>
  // Crossfade the hero slides (skipped for reduced motion).
  const slides = Array.from(document.querySelectorAll<HTMLElement>(".hero__media"));
  if (slides.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let current = 0;
    setInterval(() => {
      slides[current].classList.remove("is-active");
      current = (current + 1) % slides.length;
      slides[current].classList.add("is-active");
    }, 6000);
  }
</script>
