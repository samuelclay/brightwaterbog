---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Minimap from "../components/Minimap.astro";
import Stop from "../components/Stop.astro";
import PieceRows from "../components/PieceRows.astro";
import PoemGallery from "../components/PoemGallery.astro";
import VisitPanel from "../components/VisitPanel.astro";
import photosData from "../data/photos.json";

const photos = photosData as Record<string, any[]>;
const all = await getCollection("sculptures");

const outdoor = all
  .filter((e) => e.data.section === "outdoor")
  .sort((a, b) => (a.data.pathOrder ?? 999) - (b.data.pathOrder ?? 999));
const indoor = all
  .filter((e) => e.data.section === "indoor")
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map((entry) => ({ entry, photos: photos[entry.id] ?? [] }));
const unplaced = all
  .filter((e) => e.data.section === "unplaced")
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map((entry) => ({ entry, photos: photos[entry.id] ?? [] }));
// Unplaced pieces render as extra rows at the end of the indoor section.
const indoorRows = [...indoor, ...unplaced];
const poetry = all.find((e) => e.data.section === "poetry");
const poetryPhotos = poetry ? (photos[poetry.id] ?? []) : [];
---

<Base>
  <Hero />

  <main id="trail" class="trail" data-scrollstage>
    <Minimap />
    <div class="stops">
      {
        outdoor.map((entry) => (
          <Stop
            entry={entry}
            photos={photos[entry.id] ?? []}
            displayNumber={entry.data.pathOrder ?? 0}
          />
        ))
      }
    </div>
  </main>

  <section id="indoor">
    <div class="section-head">
      <h2 class="section-head__title">Indoor stained glass</h2>
      <p class="section-head__lede">
        Not part of the walk. These pieces live inside. Tap any photo to see it full
        screen. Pieces not yet placed are listed at the end.
      </p>
    </div>
    <PieceRows items={indoorRows} />
  </section>

  {
    poetry && poetryPhotos.length > 0 && (
      <section id="poetry">
        <div class="section-head">
          <h2 class="section-head__title">Poetry</h2>
        </div>
        <PoemGallery photos={poetryPhotos} />
      </section>
    )
  }

  <section id="visit">
    <div class="section-head">
      <h2 class="section-head__title">Visit</h2>
    </div>
    <div class="visit-wrap"><VisitPanel /></div>
  </section>

  <footer class="site-foot">
    <span>Bright Water Bog · Shutesbury, MA</span>
    <span>Sculpture by Julian Janowitz · Hoopla Pyramid by Samuel Clay &amp; Brittany Janis</span>
  </footer>

  {/* Fullscreen zoom viewer (global) */}
  <div class="lightbox" data-lightbox-root hidden aria-hidden="true">
    <div class="lightbox__stage" data-lightbox-stage>
      <img class="lightbox__img" data-lightbox-img alt="" />
    </div>
    <span class="lightbox__era" data-lightbox-era hidden></span>
    {/* Inline SVG icons, not text glyphs — iOS renders ✕/‹/› with off-kilter
        vertical metrics, so the characters never sit centered in the button. */}
    <button class="lightbox__close" data-lightbox-close type="button" aria-label="Close">
      <svg viewBox="0 0 12 12" width="14" height="14" aria-hidden="true"
        ><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
    </button>
    <button class="lightbox__nav lightbox__nav--prev" data-lightbox-prev type="button" aria-label="Previous">
      <svg viewBox="0 0 12 12" width="15" height="15" aria-hidden="true"
        ><path d="M8 1.5L3.5 6 8 10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"></path></svg>
    </button>
    <button class="lightbox__nav lightbox__nav--next" data-lightbox-next type="button" aria-label="Next">
      <svg viewBox="0 0 12 12" width="15" height="15" aria-hidden="true"
        ><path d="M4 1.5L8.5 6 4 10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"></path></svg>
    </button>
  </div>

  <script>
    import "../islands/bog-scatter";
    import "../islands/nav-spy";
    import "../islands/hero-ripple";
    import "../islands/scroll-stage";
    import "../islands/photo-strip";
    import "../islands/lightbox";
  </script>
</Base>
