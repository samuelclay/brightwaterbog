# SSH alias or hostname for the Home Assistant OS host.
HA_HOST=cabinha

# LAN address advertised by cameras.local and used for the shared add-ons.
CAMERA_MDNS_ADDRESS=192.0.2.10

# Production defaults are one Eufy livestream at a time and a five-minute target.
CAMERA_MONITOR_HA_EUFY_VIEWER_SLOTS=1
CAMERA_MONITOR_HA_EUFY_REFRESH_SECONDS=300
