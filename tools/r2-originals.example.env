# Copy to tools/r2-originals.local.env and keep the real values out of git.
#
# Create the bucket in the ofbrooklyn Cloudflare account, then create an R2
# access key that can read/write this bucket. The sync script uses the
# S3-compatible R2 endpoint through the AWS CLI.

BWB_R2_ACCOUNT_ID=replace-with-cloudflare-account-id
BWB_R2_BUCKET=brightwaterbog-originals
BWB_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
BWB_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# The bucket stores keys relative to photos/, so the local tree below syncs to:
#   s3://brightwaterbog-originals/apple-photos-stained-glass/...
BWB_R2_PREFIX=apple-photos-stained-glass
BWB_ORIGINALS_LOCAL_DIR=photos/apple-photos-stained-glass
